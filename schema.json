{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dongtingshuo/chinese-internet-and-ict-reports-qa-dataset/blob/main/schema.json",
  "title": "Chinese Internet and ICT Reports QA Dataset v2.0.0 record",
  "description": "The active corpus unifies all v1.2.0 records with new v2 records. Historical rows remain in the recommended subset by dataset-owner instruction while their v2 content-review status remains explicit. Records use mixed record-level licenses; the package is not a human-reviewed gold benchmark.",
  "oneOf": [
    { "$ref": "#/$defs/historical_candidate_v2" },
    { "$ref": "#/$defs/new_candidate_v2" }
  ],
  "$defs": {
    "common_v2_fields": {
      "type": "object",
      "required": ["dataset_version", "task_family", "task_subtype", "review_status", "review_provenance", "recommended_for_evaluation", "split_provenance", "supersedes_query_id"],
      "properties": {
        "dataset_version": { "const": "2.0.0" },
        "task_family": { "type": "string", "minLength": 1 },
        "task_subtype": { "type": "string", "minLength": 1 },
        "review_status": { "type": "string", "minLength": 1 },
        "review_provenance": { "type": "object" },
        "recommended_for_evaluation": { "type": "boolean" },
        "split_provenance": { "type": "object" },
        "supersedes_query_id": { "type": ["string", "null"] }
      }
    },
    "historical_candidate_v2": {
      "allOf": [
        { "$ref": "#/$defs/common_v2_fields" },
        {
          "type": "object",
          "required": ["schema_version", "query_id", "question", "gold_answer", "answerability", "source_ids", "source_refs", "publication_rights", "split", "task_type", "human_reviewed"],
          "properties": {
            "schema_version": { "enum": ["iicr_report_qa_v1_1", "iicr_report_qa_v1_2", "legacy_main_domain_gold_candidate_record_v1"] },
            "query_id": { "type": "string", "pattern": "^(IICR-V1[12]-[0-9]{4}|M3-TR-CAND-[0-9]{4})$" },
            "question": { "type": "string", "minLength": 1 },
            "gold_answer": { "type": "string", "minLength": 1 },
            "answerability": { "enum": ["answerable", "unanswerable"] },
            "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "source_refs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
            "publication_rights": { "type": "object", "required": ["record_license", "required_source_attributions", "source_license_obligations"] },
            "split": { "enum": ["TRAIN", "DEV", "TEST"] },
            "task_type": { "type": "string" },
            "human_reviewed": { "const": false },
            "recommended_for_evaluation": { "const": true }
          }
        }
      ]
    },
    "new_candidate_v2": {
      "allOf": [
        { "$ref": "#/$defs/common_v2_fields" },
        {
          "type": "object",
          "required": ["schema_version", "query_id", "question", "gold_answer", "answerability", "required_facts", "gold_evidence_sets", "source_ids", "source_refs", "publication_rights", "split", "task_type", "human_reviewed", "gold_candidate"],
          "properties": {
            "schema_version": { "const": "iicr_report_qa_v2_0" },
            "query_id": { "type": "string", "pattern": "^IICR-V20-[0-9]{4}$" },
            "question": { "type": "string", "minLength": 1 },
            "gold_answer": { "type": "string", "minLength": 1 },
            "answerability": { "const": "answerable" },
            "required_facts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["fact_id", "statement"] } },
            "gold_evidence_sets": { "type": "array", "minItems": 1 },
            "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "source_refs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
            "publication_rights": { "type": "object", "required": ["record_license", "required_source_attributions", "required_adaptation_disclaimers", "source_license_obligations"] },
            "split": { "enum": ["TRAIN", "DEV", "TEST"] },
            "task_type": { "type": "string" },
            "human_reviewed": { "const": false },
            "gold_candidate": { "const": false },
            "recommended_for_evaluation": { "const": true }
          }
        }
      ]
    }
  }
}
